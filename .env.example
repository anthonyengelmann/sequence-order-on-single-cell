# ============================================================
# .env.example — template for environment variables
# ============================================================
# Copy this file to `.env` and fill in real values. The .env file is
# gitignored, so secrets never enter git history.
# ============================================================

# Override the data directory location (default: ./data)
DATA_DIR=/path/to/your/data

# Weights & Biases API key (when we wire up experiment tracking)
# Get yours at https://wandb.ai/authorize
# WANDB_API_KEY=

# Hugging Face token (when we pull pretrained tokenizers or models)
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=
